<!DOCTYPE html>
<html lang="en" xmlns:th="http://www.thymeleaf.org">
    <head>
        <th:block th:insert="~{fragments/common/html-fragment-default-meta :: meta}"></th:block>
        <title>Assessment Schedule - Little Leaps Learning Center</title>
        <th:block th:insert="~{fragments/staff/common/html-fragment-staff-common-css :: staff-common-css}"></th:block>
        <link th:href="@{/css/staff/lllc-default-styles.css}" rel="stylesheet" type="text/css">
        <link th:href="@{/css/staff/clients/client-schedule/lllc-staff-client-assessment-schedule-styles.css}" rel="stylesheet" type="text/css">
    </head>
    <body class="container-fluid p-0" id="page-top">
        <div id="wrapper">
            <!-- Sidebar - Start -->
            <th:block th:insert="~{fragments/staff/common/html-fragment-staff-sidebar :: staff-common-sidebar(${nav})}"></th:block>
            <!-- Sidebar - End -->

            <div id="content-wrapper" class="d-flex flex-column">
                <div id="content">

                    <!-- Main Navigation Bar - Start -->
                    <th:block th:insert="~{fragments/staff/common/html-fragment-staff-main-navbar :: staff-common-main-navbar}"></th:block>
                    <!-- Main Navigation Bar - End -->

                    <div class="container-fluid">

                        <!-- Page Heading and Breadcrumbs - Start -->
                        <th:block th:insert="~{fragments/staff/common/html-fragment-staff-breadcrumbs :: staff-breadcrumb-section(${pageTitle}, ${breadcrumbs})}"></th:block>
                        <!-- Page Heading and Breadcrumbs - End -->

                        <!-- Assessment Schedule - Start -->
<!--                        <th:block th:insert="~{fragments/staff/clients/assignment/assign/html-fragment-staff-assign-client :: staff-assign-client(${staff})}"></th:block>-->
                        <!-- Assessment Schedule - End -->
                        <div class="app">
                            <main class="main">
                                <section class="content">
                                    <div class="client-card">
                                        <div class="client-info">

                                            <div class="client-avatar">
                                                <img src="https://i.pravatar.cc/150?img=47" alt="Client">
                                            </div>

                                            <div class="client-details">
                                                <div class="client-name-row">
                                                    <h2>Cotton Trampe Anduiza</h2>
                                                    <span class="status-badge active">
                                                        Active
                                                    </span>
                                                </div>

                                                <div class="client-meta">
                                                    <span>
                                                        Client ID:
                                                        <strong>CLI-000001</strong>
                                                    </span>

                                                    <span>
                                                        Program Type:
                                                        <strong>ABA</strong>
                                                    </span>

                                                    <span>
                                                        Branch:
                                                        <strong>Catanuan Quezon</strong>
                                                    </span>
                                                </div>
                                            </div>
                                        </div>

                                        <button class="btn btn-outline">
                                            <i class="fa-solid fa-user"></i>
                                            View Client Profile
                                        </button>
                                    </div>

                                    <!-- =========================
                                         SCHEDULE CARD
                                    ========================== -->
                                    <div class="schedule-card">
                                        <div class="schedule-header">
                                            <div>
                                                <h2>
                                                    <i class="fa-regular fa-calendar-days"></i>
                                                    Assessment Schedules
                                                </h2>

                                                <p>
                                                    Manage and view assessment schedules
                                                </p>
                                            </div>

                                            <div class="schedule-actions">
<!--                                                <div class="view-switch">-->
<!--                                                    <button id="weeklyViewBtn" class="view-btn active">-->
<!--                                                        Weekly View-->
<!--                                                    </button>-->

<!--                                                    <button id="monthlyViewBtn" class="view-btn">-->
<!--                                                        Monthly View-->
<!--                                                    </button>-->
<!--                                                </div>-->

                                                <div class="week-navigation">
                                                    <button id="previousWeek">
                                                        <i class="fa-solid fa-chevron-left"></i>
                                                    </button>

                                                    <div id="weekLabel">
                                                        Aug 11 - Aug 17, 2026
                                                    </div>

                                                    <button id="nextWeek">
                                                        <i class="fa-solid fa-chevron-right"></i>
                                                    </button>
                                                </div>

                                                <button id="openScheduleModal" class="btn btn-primary">
                                                    <i class="fa-solid fa-plus"></i>
                                                    Add Schedule
                                                </button>
                                            </div>
                                        </div>


                                        <!-- =========================
                                             CALENDAR
                                        ========================== -->
                                        <div class="calendar-container">
                                            <div id="calendar"></div>
                                        </div>

                                        <!-- ADD THERAPIST -->
                                        <button id="addTherapist" class="add-therapist">
                                            <i class="fa-solid fa-plus"></i>
                                            Add Another Therapist
                                        </button>

                                        <!-- LEGEND -->
                                        <div class="legend">
                                            <div>
                                                <span class="legend-title">
                                                    Legend
                                                </span>

                                                <span class="legend-item">
                                                    <span class="legend-color scheduled"></span>
                                                    Scheduled
                                                </span>

                                                <span class="legend-item">
                                                    <span class="legend-color pending"></span>
                                                    Pending
                                                </span>

                                                <span class="legend-item">
                                                    <span class="legend-color cancelled"></span>
                                                    Cancelled
                                                </span>

                                                <span class="legend-item">
                                                    <span class="legend-color completed"></span>
                                                    Completed
                                                </span>
                                            </div>

                                            <div class="timezone">
                                                <i class="fa-regular fa-clock"></i>
                                                All times are displayed in local time
                                            </div>
                                        </div>
                                    </div>
                                </section>
                            </main>
                        </div>


